{
  "name": "yapmod",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "client:build": "node scripts/build.mjs client",
    "client:dev": "node scripts/build.mjs client --watch",
    "client:check": "tsc -p client/tsconfig.json",
    "test:scripts": "node --test scripts/*.test.mjs",
    "types:generate": "node scripts/build.mjs types",
    "check": "pnpm test:scripts && pnpm check:client && pnpm check:rust && pnpm check:web",
    "check:client": "pnpm client:check && pnpm client:build",
    "check:rust": "pnpm check:rust:format && pnpm check:rust:clippy && pnpm check:types",
    "check:rust:format": "cargo fmt --manifest-path ./src-tauri/Cargo.toml --all -- --check",
    "check:rust:clippy": "cargo clippy --manifest-path ./src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "check:types": "node scripts/build.mjs types --check",
    "check:web": "node scripts/build.mjs web check && node scripts/build.mjs web build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "typescript": "~6.0.3"
  }
}
