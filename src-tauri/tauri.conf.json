{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yapmod",
  "identifier": "io.ilyeshdz.yapmod",
  "build": {
    "beforeDevCommand": "pnpm client:build",
    "devUrl": "http://www.yapin.gg/",
    "beforeBuildCommand": "pnpm client:build",
    "frontendDist": "https://www.yapin.gg/"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "./dmgly/assets/dmg-background.png",
        "windowSize": {
          "width": 642,
          "height": 406
        },
        "appPosition": {
          "x": 173,
          "y": 213
        },
        "applicationFolderPosition": {
          "x": 479,
          "y": 213
        }
      }
    }
  }
}
