{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "allow-set-settings",
    "allow-set-badge-count",
    "allow-notify",
    "allow-request-notification-permission",
    "allow-check-for-update",
    "allow-confirm-client-update",
    "allow-get-client-update-launch-status",
    "allow-prepare-client-update",
    "allow-restart-app",
    "allow-minimize-main-window",
    "allow-toggle-main-window-maximize",
    "allow-close-main-window",
    "allow-get-changelog",
    "allow-list-themes",
    "allow-list-community-themes",
    "allow-themes-folder",
    "allow-open-themes-folder",
    "allow-pick-theme-folder",
    "allow-install-theme",
    "allow-install-community-theme",
    "allow-remove-theme",
    "allow-pick-plugin-folder",
    "allow-install-picked-plugin",
    "allow-list-plugins",
    "allow-list-community-plugins",
    "allow-preview-community-plugin",
    "allow-install-community-plugin",
    "allow-open-plugins-folder",
    "allow-remove-plugin"
  ],
  "remote": {
    "urls": ["https://yapin.gg", "https://www.yapin.gg"]
  }
}
