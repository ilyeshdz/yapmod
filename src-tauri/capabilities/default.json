{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "opener:allow-open-url",
    "allow-set-settings",
    "allow-set-badge-count",
    "allow-notify",
    "allow-request-notification-permission",
    "allow-check-for-update",
    "allow-confirm-client-update",
    "allow-get-changelog",
    "allow-list-themes",
    "allow-themes-folder",
    "allow-open-themes-folder",
    "allow-pick-theme-folder",
    "allow-install-theme",
    "allow-remove-theme"
  ],
  "remote": {
    "urls": ["https://yapper.website", "https://www.yapper.website"]
  }
}
