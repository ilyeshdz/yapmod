{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": []
  },
  "include": ["*.ts", "*.tsx", "shared/**/*.ts", "shared/**/*.tsx", "core/**/*.ts", "core/**/*.tsx", "components/**/*.tsx", "features/**/*.ts", "features/**/*.tsx", "types/**/*.ts", "generated/**/*.ts"]
}
