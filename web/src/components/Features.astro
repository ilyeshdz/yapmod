---
const features = [
  {
    title: "A desktop app that feels at home",
    body: "Get a dedicated window, system notifications and an unread badge, with an optional menu bar or tray icon to keep yapmod running.",
    icon: `<rect x="5" y="8" width="38" height="26" rx="5"></rect><path d="M17 42h14M24 34v8"></path>`,
  },
  {
    title: "Make it yours",
    body: "Choose a theme or create your own with CSS. Your settings and themes stay on your computer.",
    icon: `<path d="M24 5a19 19 0 1 0 0 38h3a4 4 0 0 0 2.8-6.8 3 3 0 0 1 2.1-5.2H36a7 7 0 0 0 7-7C43 13.5 34.5 5 24 5z"></path><circle cx="14" cy="18" r="2"></circle><circle cx="23" cy="13" r="2"></circle><circle cx="33" cy="18" r="2"></circle>`,
  },
  {
    title: "Open source, across platforms",
    body: "Use yapmod on Windows, macOS or Linux. The project is public, so you can see how it works and help shape what comes next.",
    icon: `<path d="M29 11l-8 26M14 17L6 24l8 7M34 17l8 7-8 7"></path>`,
  },
];
---

<section class="sec" id="why">
  <div class="wrap">
    <h2>Its own app, open to everyone.</h2>
    <p class="sub">
      yapmod gives Yapin a dedicated desktop home and keeps the whole project public, so the
      community can shape it.
    </p>

    <div class="cols">
      {
        features.map((feature) => (
          <div class="col">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="url(#gg)"
              stroke-width="3.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <defs>
                <lineargradient id="gg" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#DD5A8C" />
                  <stop offset=".55" stop-color="#E87DA6" />
                  <stop offset="1" stop-color="#F2A3C5" />
                </lineargradient>
              </defs>
              <Fragment set:html={feature.icon} />
            </svg>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
