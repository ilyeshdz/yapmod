---
---

<dialog id="search-palette" class="palette" aria-label="Search the documentation">
  <div class="palette-box">
    <div class="palette-field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M16.5 16.5 21 21"></path>
      </svg>
      <input
        id="palette-input"
        type="search"
        placeholder="Search the documentation"
        autocomplete="off"
        spellcheck="false"
        aria-controls="palette-results"
      />
      <kbd>esc</kbd>
    </div>

    <ul id="palette-results" class="palette-results" role="listbox" aria-label="Search results"></ul>

    <div class="palette-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<!--
  The results are built in the browser, so their styles cannot be scoped by
  Astro. They are written globally instead, prefixed with `.palette`.
-->
<style is:global>
  .palette {
    width: min(640px, calc(100vw - 32px));
    padding: 0;
    border: 1.5px solid var(--line);
    border-radius: 18px;
    background: var(--s);
    color: var(--t);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }

  .palette::backdrop {
    background: rgba(10, 6, 12, 0.6);
    backdrop-filter: blur(3px);
  }

  .palette .palette-box {
    display: flex;
    flex-direction: column;
    max-height: min(70vh, 560px);
  }

  .palette .palette-field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1.5px solid var(--line);
  }

  .palette .palette-field > svg {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--m);
  }

  .palette .palette-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--t);
    font: 500 17px Figtree, sans-serif;
    outline: none;
  }

  .palette .palette-field input::placeholder {
    color: var(--m);
  }

  /* The native clear button is loud, the palette has its own affordances. */
  .palette .palette-field input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .palette kbd {
    padding: 2px 6px;
    border: 1.5px solid var(--line);
    border-radius: 6px;
    font: 600 11px Figtree, sans-serif;
    color: var(--m);
    white-space: nowrap;
  }

  .palette .palette-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }

  .palette .palette-results li + li {
    margin-top: 2px;
  }

  .palette .palette-results a {
    display: block;
    padding: 10px 12px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--t);
  }

  .palette .palette-results a.on,
  .palette .palette-results a:hover {
    background: var(--accent-soft);
  }

  .palette .palette-results .row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .palette .palette-results strong {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .palette .palette-results .group {
    flex: none;
    padding: 1px 7px;
    border-radius: 99px;
    background: var(--bg);
    border: 1.5px solid var(--line);
    color: var(--m);
    font: 700 10px/1.6 Figtree, sans-serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .palette .palette-results .snippet {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
    margin-top: 3px;
    color: var(--m);
    font-size: 13.5px;
    line-height: 1.45;
  }

  .palette .palette-results .empty {
    padding: 22px 12px;
    color: var(--m);
    font-size: 15px;
    text-align: center;
  }

  .palette .palette-footer {
    display: flex;
    gap: 18px;
    padding: 12px 18px;
    border-top: 1.5px solid var(--line);
    color: var(--m);
    font-size: 13px;
  }

  .palette .palette-footer span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
</style>

<script>
  import { excerpt, loadIndex, searchIndex } from "../../lib/search";
  import { onPageLoad } from "../../lib/lifecycle";

  onPageLoad((signal) => {
    const dialog = document.getElementById("search-palette") as HTMLDialogElement | null;
    const input = document.getElementById("palette-input") as HTMLInputElement | null;
    const results = document.getElementById("palette-results") as HTMLUListElement | null;

    if (!dialog || !input || !results) return;

    let matches: Awaited<ReturnType<typeof loadIndex>> = [];
    let active = 0;

    const render = (query: string) => {
      results.innerHTML = "";

      if (matches.length === 0) {
        const empty = document.createElement("li");
        empty.className = "empty";
        empty.textContent = query ? "Nothing found." : "Type to search the documentation.";
        results.append(empty);
        return;
      }

      matches.forEach((item, index) => {
        const li = document.createElement("li");

        const link = document.createElement("a");
        link.href = item.url;
        link.className = index === active ? "on" : "";

        const row = document.createElement("div");
        row.className = "row";

        const title = document.createElement("strong");
        title.textContent = item.title;

        const group = document.createElement("span");
        group.className = "group";
        group.textContent = item.group;

        const snippet = document.createElement("div");
        snippet.className = "snippet";
        snippet.textContent = item.description || excerpt(item.text, query);

        row.append(title, group);
        link.append(row, snippet);
        li.append(link);
        results.append(li);
      });
    };

    const update = async () => {
      const query = input.value;
      const index = await loadIndex();

      if (signal.aborted) return;

      matches = searchIndex(index, query);
      active = 0;
      render(query);
    };

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
      input.select();
      void update();
    };

    // Cmd+K (or Ctrl+K) opens the palette from anywhere on the page.
    document.addEventListener(
      "keydown",
      (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          open();
          return;
        }

        if (!dialog.open) return;

        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          if (matches.length === 0) return;

          active =
            (active + (event.key === "ArrowDown" ? 1 : -1) + matches.length) % matches.length;
          render(input.value);
          results.querySelectorAll("a")[active]?.scrollIntoView({ block: "nearest" });
        }

        if (event.key === "Enter" && matches[active]) {
          event.preventDefault();
          window.location.href = matches[active].url;
        }
      },
      { signal },
    );

    input.addEventListener("input", update, { signal });

    // Clicking the backdrop closes the palette.
    dialog.addEventListener(
      "click",
      (event) => {
        if (event.target === dialog) dialog.close();
      },
      { signal },
    );

    dialog.addEventListener(
      "close",
      () => {
        input.value = "";
        matches = [];
      },
      { signal },
    );

    // The sidebar search opens the palette as well, so there is one place to type.
    const sidebarInput = document.getElementById("docs-search") as HTMLButtonElement | null;

    sidebarInput?.addEventListener("click", open, { signal });

    // Make the shortcut discoverable.
    for (const hint of document.querySelectorAll<HTMLElement>(".search-hint")) {
      const isMac = /mac/i.test(navigator.platform || "");
      hint.textContent = isMac ? "⌘K" : "Ctrl K";
    }
  });
</script>
