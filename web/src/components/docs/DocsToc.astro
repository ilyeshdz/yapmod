---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <h4>On this page</h4>
      <ul>
        {items.map((heading) => (
          <li class:list={{ sub: heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    top: 69px;
    align-self: start;
    overflow-y: visible;
    padding: 24px 22px 48px 4px;
    font-size: 14px;
  }

  h4 {
    margin: 0 0 8px;
    font: 700 12px Figtree, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--m);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li.sub {
    padding-left: 14px;
  }

  a {
    display: block;
    padding: 2px 0 2px 12px;
    color: var(--m);
    text-decoration: none;
  }

  a:hover {
    color: var(--t);
  }

  @media (max-width: 1200px) {
    .toc {
      display: none;
    }
  }
</style>
