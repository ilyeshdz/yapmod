---
import ThemeToggle from "../ThemeToggle.astro";
import { type DocArea } from "../../lib/docs";

interface Props {
  area?: DocArea;
}

const { area } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<header class="docs-header">
  <a class="brand" href={`${base}/`}>
    <span class="logo" role="img" aria-label="yapmod logo"></span>
    yapmod
  </a>
  <span class="tag">docs</span>

  <span class="spacer"></span>

  <nav class="header-links" aria-label="Site">
    <a href={`${base}/`}>Home</a>
    <a href={`${base}/docs/plugins`} class:list={{ on: area === "plugins" }}>Plugins</a>
    <a href={`${base}/docs/themes`} class:list={{ on: area === "themes" }}>Themes</a>
    <a href="https://github.com/ilyeshdz/yapmod">GitHub</a>
  </nav>

  <div class="header-actions">
    <ThemeToggle />
    <a class="btn sm g" href="https://github.com/ilyeshdz/yapmod/releases">Download</a>
  </div>

  <button class="menu-toggle" type="button" id="docs-menu" aria-expanded="false" aria-controls="docs-sidebar">
    <span class="sr-only">Toggle the documentation menu</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>
</header>

<style>
  .docs-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 24px;
    border-bottom: 1.5px solid var(--line);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font: 800 20px Sora, sans-serif;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--t);
  }

  .brand .logo {
    width: 30px;
  }

  .tag {
    font: 600 12px Figtree, sans-serif;
    background: var(--g);
    color: var(--on);
    padding: 2px 10px;
    border-radius: 99px;
  }

  .spacer {
    flex: 1;
  }

  .header-links {
    display: flex;
    gap: 22px;
    font-size: 15px;
    font-weight: 600;
    color: var(--m);
  }

  .header-links a {
    text-decoration: none;
    color: var(--m);
    padding: 4px 0;
    border-bottom: 2px solid transparent;
  }

  .header-links a:hover {
    color: var(--t);
  }

  .header-links a.on {
    color: var(--t);
    border-bottom-color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 12px;
    border: 1.5px solid var(--line);
    background: transparent;
    color: var(--t);
    cursor: pointer;
  }

  .menu-toggle svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 900px) {
    .docs-header {
      padding: 12px 18px;
    }

    .header-links {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }
</style>
