---
/**
 * Custom Starlight Search with enhanced styling.
 * Adds accent color borders, glow effects, and improved results styling.
 */
import Default from '@astrojs/starlight/components/Search.astro';
---
<Default><slot /></Default>
<style>
  /* Search input wrapper */
  .search-wrapper {
    border-radius: 12px !important;
    border: 1.5px solid rgba(221, 90, 140, 0.2) !important;
    background: rgba(28, 21, 36, 0.8) !important;
    transition: all 0.25s ease !important;
    position: relative;
  }

  .search-wrapper:hover,
  .search-wrapper:focus-within {
    border-color: rgba(221, 90, 140, 0.4) !important;
    box-shadow: 0 0 0 4px rgba(221, 90, 140, 0.08) !important;
  }

  [data-theme="light"] .search-wrapper {
    background: rgba(255, 255, 255, 0.8) !important;
    border-color: rgba(221, 90, 140, 0.15) !important;
  }

  /* Search input */
  .search-input {
    font-family: "Geist", system-ui, -apple-system, sans-serif !important;
    background: transparent !important;
    border: none !important;
    color: var(--sl-text) !important;
  }

  .search-input::placeholder {
    color: var(--sl-muted) !important;
    font-family: "Geist", system-ui, -apple-system, sans-serif !important;
  }

  /* Search shortcut badge */
  .search-shortcut {
    border-radius: 6px !important;
    border: 1px solid rgba(221, 90, 140, 0.2) !important;
    background: rgba(221, 90, 140, 0.08) !important;
    color: rgba(221, 90, 140, 0.8) !important;
    font-family: "Geist Mono", monospace !important;
    font-size: 0.7rem !important;
    padding: 2px 6px !important;
  }

  /* Search modal/overlay */
  .search-modal {
    border-radius: 16px !important;
    border: 1.5px solid rgba(221, 90, 140, 0.2) !important;
    background: rgba(19, 14, 24, 0.98) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4) !important;
  }

  [data-theme="light"] .search-modal {
    background: rgba(255, 247, 245, 0.98) !important;
    border-color: rgba(221, 90, 140, 0.15) !important;
  }

  /* Search results */
  .search-results {
    max-height: 60vh !important;
  }

  .search-result {
    border-radius: 10px !important;
    transition: all 0.2s ease !important;
    border-left: 3px solid transparent !important;
  }

  .search-result:hover,
  .search-result.active {
    background: rgba(221, 90, 140, 0.08) !important;
    border-left-color: #DD5A8C !important;
  }

  .search-result mark {
    background: rgba(221, 90, 140, 0.25) !important;
    color: #DD5A8C !important;
    border-radius: 2px;
    padding: 0 2px;
  }

  /* Search categories */
  .search-category {
    font-family: "Geist Pixel", monospace !important;
    font-size: 0.7rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    color: rgba(221, 90, 140, 0.7) !important;
  }

  /* Search footer */
  .search-footer {
    border-top: 1px solid rgba(221, 90, 140, 0.1) !important;
    padding: 0.8rem 1rem !important;
  }

  .search-footer kbd {
    border-radius: 4px !important;
    border: 1px solid rgba(221, 90, 140, 0.2) !important;
    background: rgba(221, 90, 140, 0.08) !important;
    font-family: "Geist Mono", monospace !important;
    font-size: 0.65rem !important;
    padding: 1px 5px !important;
  }
</style>
