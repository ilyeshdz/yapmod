---
/**
 * Custom Starlight Header with enhanced styling for yapmod.
 * Adds backdrop blur, gradient branding, and smooth transitions.
 */
import Default from '@astrojs/starlight/components/Header.astro';
---
<Default><slot /></Default>
<style>
  /* Enhanced header with backdrop blur and gradient border */
  .sl-header {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(19, 14, 24, 0.8) !important;
    border-bottom: 1.5px solid rgba(221, 90, 140, 0.15) !important;
    transition: all 0.3s ease;
  }

  [data-theme="light"] .sl-header {
    background: rgba(255, 247, 245, 0.85) !important;
    border-bottom: 1.5px solid rgba(221, 90, 140, 0.1) !important;
  }

  /* Site title with gradient text */
  .sl-header .sl-link-button {
    font-family: "Geist Pixel", monospace;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #DD5A8C 0%, #E87DA6 55%, #F2A3C5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Nav links with accent hover */
  .sl-header nav a {
    position: relative;
    transition: color 0.2s ease, background-color 0.2s ease;
    border-radius: 8px;
    padding: 6px 12px !important;
  }

  .sl-header nav a:hover {
    background: rgba(221, 90, 140, 0.1);
    color: #DD5A8C !important;
  }

  /* Search input styling */
  .sl-header .search-wrapper {
    border-radius: 12px !important;
    border: 1.5px solid rgba(221, 90, 140, 0.2) !important;
    background: rgba(28, 21, 36, 0.8) !important;
    transition: all 0.2s ease;
  }

  .sl-header .search-wrapper:hover,
  .sl-header .search-wrapper:focus-within {
    border-color: rgba(221, 90, 140, 0.4) !important;
    box-shadow: 0 0 0 3px rgba(221, 90, 140, 0.1);
  }

  [data-theme="light"] .sl-header .search-wrapper {
    background: rgba(255, 255, 255, 0.8) !important;
    border-color: rgba(221, 90, 140, 0.15) !important;
  }
</style>
