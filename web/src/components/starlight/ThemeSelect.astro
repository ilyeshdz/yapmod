---
/**
 * Custom Starlight ThemeSelect with enhanced styling.
 * Adds smooth transitions and accent color highlights.
 */
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
---
<Default><slot /></Default>
<style>
  /* Theme select button */
  .sl-theme-button {
    border-radius: 8px !important;
    padding: 6px !important;
    transition: all 0.25s ease !important;
    border: 1.5px solid transparent !important;
  }

  .sl-theme-button:hover {
    background: rgba(221, 90, 140, 0.1) !important;
    border-color: rgba(221, 90, 140, 0.2) !important;
    transform: scale(1.05);
  }

  .sl-theme-button svg {
    transition: all 0.25s ease !important;
  }

  .sl-theme-button:hover svg {
    transform: rotate(15deg);
    fill: #DD5A8C !important;
  }

  /* Theme select dropdown/menu */
  .sl-theme-select {
    border-radius: 12px !important;
    border: 1.5px solid rgba(221, 90, 140, 0.2) !important;
    background: rgba(28, 21, 36, 0.95) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3) !important;
  }

  [data-theme="light"] .sl-theme-select {
    background: rgba(255, 255, 255, 0.95) !important;
    border-color: rgba(221, 90, 140, 0.15) !important;
  }

  .sl-theme-select button {
    border-radius: 8px !important;
    transition: all 0.2s ease !important;
  }

  .sl-theme-select button:hover {
    background: rgba(221, 90, 140, 0.1) !important;
  }

  .sl-theme-select button[aria-checked="true"] {
    background: rgba(221, 90, 140, 0.15) !important;
    color: #DD5A8C !important;
  }
</style>
