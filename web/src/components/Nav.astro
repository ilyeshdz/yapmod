---
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const home = base ? `${base}/` : "/";
const isHome = Astro.url.pathname.replace(/\/+$/, "") === base;
const links = [
  { href: "#why", label: "Why yapmod" },
  { href: "#download", label: "Download" },
  { href: "#build", label: "Get involved" },
  { href: "#community", label: "Community" },
];
---

<nav class="main-nav">
  <a class="brand" href={home}>
    <span class="logo" role="img" aria-label="yapmod logo"></span>
    yapmod
  </a>

  <div class="links">
    {
      links.map((link) => (
        <a href={isHome ? link.href : `${home}${link.href}`}>{link.label}</a>
      ))
    }
    <a href={`${base}/themes`}>Themes</a>
    <a href={`${base}/docs`}>Docs</a>
  </div>

  <div class="nav-actions">
    <ThemeToggle />

    <a class="btn sm" href="https://github.com/ilyeshdz/yapmod">GitHub</a>
  </div>
</nav>
